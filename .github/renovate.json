{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>shuymn/github-actions#main"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/maltmill\\.yml$/"],
      "matchStrings": [
        "MALTMILL_VERSION: (?<currentValue>v?\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "Songmu/maltmill"
    }
  ]
}
